# SIH26166 backend/.env - NEVER commit the real .env (it's gitignored).
# Copy this file to .env and fill in only what you're using.
# Tier 0 needs NOTHING here - localhost demo runs with all values empty.

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # backend only - NEVER in frontend/git

# Upstash Redis (dashboard -> REST API section)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (backend project -> Client Key DSN)
SENTRY_DSN_BACKEND=

# Google AI Studio (Gemini - narration only, never metric generation)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash   # verify current model string at ai.google.dev/gemini-api/docs/models
NARRATE_RATE_LIMIT=20           # narration calls per minute
